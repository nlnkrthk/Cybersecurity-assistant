# Keep the ML notebooks and trained model in version control.
!ml/**/*.ipynb
!ml/**/*.pkl
# Model metadata and SHAP reference files are required by src/services/ml_service.py.
!ml/models/*.json

# Include cleaned network data, but keep the data/logs and data/processed
# directories empty in version control.
!data/cleaned_network_data/
!data/cleaned_network_data/**
!data/logs/
!data/logs/.gitkeep
!data/processed/
!data/processed/.gitkeep

# Evaluation outputs (generated)
data/evaluation/

# Analyst feedback and retrained model versions (generated)
data/feedback/
ml/models/versions/
